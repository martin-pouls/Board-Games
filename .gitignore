# Go binaries and test artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
!coverage.go
*.coverprofile
profile.cov
*/backend/bin/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Local SQLite databases
data/
*.db
*.db-shm
*.db-wal

# Frontend dependencies and build output are ignored per app in <app>/frontend/.gitignore.

# Publisher material (rulebooks, box and card photos) for rules and theme work: local only, the repo
# is public. <game>/docs/reference/, or <base>/docs/<edition>/reference/.
**/docs/**/reference/

# Playwright MCP screenshots and snapshots
.playwright-mcp/

# Local stack state (deploy/local.sh): Caddy snippets, gate secret and passwords
deploy/local/.sites/
deploy/local/.gate/
