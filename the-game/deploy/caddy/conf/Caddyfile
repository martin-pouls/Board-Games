# Shared reverse proxy for everything on yoshi-und-kruemli.de. Lives in /opt/caddy on the server;
# each app drops a snippet into sites/ (e.g. the-game.caddy) and reloads Caddy.
# HTTPS certificates are obtained and renewed automatically (Let's Encrypt).

yoshi-und-kruemli.de {
	encode zstd gzip
	import /etc/caddy/sites/*.caddy

	# Nothing at the root yet: send visitors to the game.
	redir / /the-game/
	handle {
		respond "Not found" 404
	}
}

www.yoshi-und-kruemli.de {
	redir https://yoshi-und-kruemli.de{uri} permanent
}
