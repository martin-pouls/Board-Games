# Start page site snippet imported by the shared Caddyfile (copied to /opt/caddy/conf/sites/ by every deploy).
# The prefix is stripped, so the container serves the static build at its root.
redir /board-games /board-games/
handle_path /board-games/* {
	reverse_proxy start-page:8080
}

# The start page used to be /card-games/: keep old bookmarks working ({uri} is the rest after the prefix).
redir /card-games /board-games/ permanent
handle_path /card-games/* {
	redir /board-games{uri} permanent
}
