# Start page site snippet imported by the shared Caddyfile (copied to /opt/caddy/conf/sites/ by every deploy).
# The prefix is stripped, so the container serves the static build at its root.
redir /board-games /board-games/
handle_path /board-games/* {
	# The file server sends no Cache-Control, so browsers would cache the pages heuristically and
	# miss a new game's tile for hours. Hashed assets never change; everything else is revalidated.
	@mutable not path /_app/immutable/*
	header @mutable Cache-Control "no-cache"
	header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
	# Password protected: the gate snippet in deploy/caddy/conf/common.caddy.
	import gate
	reverse_proxy start-page:8080
}

# The start page used to be /card-games/: keep old bookmarks working ({uri} is the rest after the prefix;
# the "*" is needed, a first argument starting with "/" would be read as a path matcher).
redir /card-games /board-games/ permanent
handle_path /card-games/* {
	redir * /board-games{uri} permanent
}
