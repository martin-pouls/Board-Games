# Mission Deep Sea site snippet imported by the shared Caddyfile (copied to /opt/caddy/conf/sites/ by every deploy).
# The prefix is stripped, so the Go server serves /api, /ws and the SPA at its root.
redir /deep-sea /deep-sea/
handle_path /deep-sea/* {
	# Password protected: the gate snippet in deploy/caddy/conf/common.caddy.
	import gate
	reverse_proxy deep-sea:8080
}
