# Shared reverse proxy for everything on yoshi-und-kruemli.de. Lives in /opt/caddy on the server
# (installed by deploy/setup-server.sh). deploy/deploy.sh copies each <app>/deploy/<app>.caddy into
# sites/ and reloads Caddy. HTTPS certificates are obtained and renewed automatically (Let's Encrypt).

yoshi-und-kruemli.de {
	encode zstd gzip
	import /etc/caddy/sites/*.caddy

	# The start page links to every game.
	redir / /card-games/
	handle {
		respond "Not found" 404
	}
}

www.yoshi-und-kruemli.de {
	redir https://yoshi-und-kruemli.de{uri} permanent
}
